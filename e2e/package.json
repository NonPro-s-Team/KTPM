{
  "name": "green-juice-hub-e2e",
  "private": true,
  "engines": { "node": ">=22.12.0" },
  "scripts": {
    "test": "node scripts/run-tests.js",
    "test:smoke": "node scripts/run-tests.js",
    "test:checkout": "node scripts/run-tests.js checkout",
    "test:headed": "cross-env E2E_SHOW_BROWSER=true node scripts/run-tests.js",
    "test:list": "codeceptjs dry-run --steps",
    "browsers:install": "playwright install chromium"
  },
  "devDependencies": {
    "codeceptjs": "3.7.5",
    "cross-env": "10.0.0",
    "playwright": "1.55.0",
    "mocha-junit-reporter": "2.2.1"
  }
}
