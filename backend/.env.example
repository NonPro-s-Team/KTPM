# Runtime
SPRING_PROFILES_ACTIVE=local
PORT=8081

# CORS (phân cách nhiều origin bằng dấu phẩy, không có dấu / ở cuối)
CORS_ALLOWED_ORIGINS=http://localhost:5173,https://your-frontend.example.com

# MySQL
SPRING_DATASOURCE_URL=jdbc:mysql://localhost:3306/green_juice_hub?useSSL=false&serverTimezone=Asia/Ho_Chi_Minh&allowPublicKeyRetrieval=true&characterEncoding=UTF-8
SPRING_DATASOURCE_USERNAME=root
SPRING_DATASOURCE_PASSWORD=

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Authentication
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters
GOOGLE_CLIENT_ID=
RECAPTCHA_SECRET=

# Email
MAIL_USERNAME=
MAIL_PASSWORD=
SHOP_EMAIL=

# GHN
GHN_TOKEN=
GHN_SHOP_ID=0
GHN_WEBHOOK_TOKEN=

# SePay
SEPAY_API_KEY=

# VNPay sandbox
VNPAY_TMN_CODE=
VNPAY_HASH_SECRET=
VNPAY_PAY_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
VNPAY_RETURN_URL=http://localhost:5173/payment/vnpay/result
VNPAY_IPN_URL=http://localhost:8081/api/payment/vnpay/ipn

# Gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
GEMINI_TIMEOUT_MS=15000
GEMINI_TEMPERATURE=0.4
