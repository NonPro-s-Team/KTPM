    "name": "ELearning 1 - Green Juice Hub REST API (Products)",
    "description": "Bản collection rút gọn phục vụ bài ELearning 1: Thiết lập REST API của project trên Postman. Collection minh họa module Product với 7 API GET công khai, không cần đăng nhập và không cần import Environment riêng.\n\nCách chạy: khởi tạo MySQL bằng database/schema.sql và database/seed.sql, chạy Redis và backend tại http://localhost:8081, import file này vào Postman, sau đó Run collection theo đúng thứ tự từ 01 đến 07.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "01 - Product REST API",
      "description": "Các REST API công khai của ProductController, tương ứng module sản phẩm trong backend.",
      "item": [
        {
          "name": "01 - List products",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
                  "pm.test('Response là Page và có content array', () => {",
                  "  const body = pm.response.json();",
                  "  pm.expect(body).to.have.property('content');",
                  "  pm.expect(body.content).to.be.an('array');",
                  "});",
                  "const body = pm.response.json();",
                  "if (body.content && body.content.length > 0 && body.content[0].slug) {",
                  "  pm.collectionVariables.set('sampleProductSlug', body.content[0].slug);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/products?page=0&size=12",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "products"
              ],
              "query": [
                {
                  "key": "page",
                  "value": "0"
                },
                {
                  "key": "size",
                  "value": "12"
                }
              ]
            },
            "description": "GET /api/products — lấy danh sách sản phẩm dạng phân trang. Request này tự lưu slug của sản phẩm đầu tiên để request 02 sử dụng."
          },
          "response": []
        },
        {
          "name": "02 - Get product detail by slug",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
                  "pm.test('Response có variants array', () => pm.expect(pm.response.json()).to.have.property('variants'));"
                ]
              }
            }
          ],
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "GET",
            "header": [],
