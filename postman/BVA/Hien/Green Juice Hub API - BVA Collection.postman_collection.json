            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "packages": {},
                "requests": {},
                "exec": [
                  "const testCases = {\r",
                  "    \"TC-01 / null\": {\r",
                  "        expectedStatus: 400,\r",
                  "        type: \"invalid\"\r",
                  "    },\r",
                  "\r",
                  "    \"TC-02 / empty\": {\r",
                  "        expectedStatus: 400,\r",
                  "        type: \"invalid\"\r",
                  "    },\r",
                  "\r",
                  "    \"TC-03 / blank\": {\r",
                  "        expectedStatus: 400,\r",
                  "        type: \"invalid\"\r",
                  "    },\r",
                  "\r",
                  "    \"TC-04 / Boundary - 1\": {\r",
                  "        expectedStatus: 400,\r",
                  "        type: \"invalid\"\r",
                  "    },\r",
                  "\r",
                  "    \"TC-05 / Boundary\": {\r",
                  "        expectedStatus: 200,\r",
                  "        type: \"valid\"\r",
                  "    },\r",
                  "\r",
                  "    \"TC-06 / Boundary + 1\": {\r",
                  "        expectedStatus: 400,\r",
                  "        type: \"invalid\"\r",
                  "    },\r",
                  "\r",
                  "    \"TC-07 / Invalid partition\": {\r",
                  "        expectedStatus: 400,\r",
                  "        type: \"invalid\"\r",
                  "    },\r",
                  "\r",
                  "    \"TC-08 / Invalid partition\": {\r",
                  "        expectedStatus: 400,\r",
                  "        type: \"invalid\"\r",
                  "    },\r",
                  "\r",
                  "    \"TC-09 / Unexpected valid length\": {\r",
                  "        expectedStatus: 400,\r",
                  "        type: \"invalid\"\r",
                  "    },\r",
                  "\r",
                  "    \"TC-10 / Unexpected valid character\": {\r",
                  "        expectedStatus: 400,\r",
                  "        type: \"invalid\"\r",
                  "    },\r",
                  "\r",
                  "    \"TC-11 / Unexpected larger valid length\": {\r",
                  "        expectedStatus: 400,\r",
                  "        type: \"invalid\"\r",
                  "    }\r",
                  "};\r",
                  "\r",
                  "const requestName = pm.info.requestName;\r",
                  "const tc = testCases[requestName];\r",
                  "\r",
                  "if (tc) {\r",
                  "\r",
                  "    pm.test(\r",
                  "        `${requestName} - Expected HTTP ${tc.expectedStatus}`,\r",
                  "        function () {\r",
                  "            pm.expect(pm.response.code)\r",
                  "                .to.eql(tc.expectedStatus);\r",
                  "        }\r",
                  "    );\r",
                  "\r",
                  "    pm.test(\r",
                  "        `${requestName} - Không được trả 500`,\r",
                  "        function () {\r",
                  "            pm.expect(pm.response.code)\r",
                  "                .to.not.eql(500);\r",
                  "        }\r",
                  "    );\r",
                  "\r",
                  "    let body = {};\r",
                  "\r",
                  "    try {\r",
                  "        body = pm.response.json();\r",
                  "    } catch (e) {\r",
                  "        body = {};\r",
                  "    }\r",
                  "\r",
                  "    if (tc.type === \"invalid\") {\r",
                  "\r",
                  "        pm.test(\r",
                  "            `${requestName} - Có validation error`,\r",
                  "            function () {\r",
                  "                pm.expect(body)\r",
                  "                    .to.have.property(\"message\");\r",
                  "\r",
                  "                pm.expect(body.message)\r",
                  "                    .to.include(\"phone\");\r",
                  "            }\r",
                  "        );\r",
                  "\r",
                  "    }\r",
                  "\r",
                  "    if (tc.type === \"valid\") {\r",
                  "\r",
                  "        pm.test(\r",
                  "            `${requestName} - Trả AccountCheckResponse`,\r",
                  "            function () {\r",
                  "                pm.expect(body)\r",
                  "                    .to.have.property(\"exists\");\r",
                  "\r",
                  "                pm.expect(body)\r",
                  "                    .to.have.property(\"hasPassword\");\r",
                  "\r",
                  "                pm.expect(body)\r",
                  "                    .to.have.property(\"newUser\");\r",
                  "            }\r",
                  "        );\r",
                  "\r",
                  "    }\r",
                  "}"
                ]
              }
            }
          ]
