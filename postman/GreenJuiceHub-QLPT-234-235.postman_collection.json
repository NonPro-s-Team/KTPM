          "request": { "auth": { "type": "noauth" }, "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }, { "key": "X-Test-Case", "value": "MANUAL-AUTH-003" }], "body": { "mode": "raw", "raw": "{\"tempToken\":\"{{tempToken}}\",\"newPassword\":\"{{manualNewPassword}}\"}" }, "url": "{{baseUrl}}/api/auth/reset-password" },
          "event": [
