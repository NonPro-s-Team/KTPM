          "request": { "auth": { "type": "noauth" }, "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }, { "key": "X-Test-Case", "value": "MANUAL-AUTH-004" }], "body": { "mode": "raw", "raw": "{\"idToken\":\"{{googleIdToken}}\"}" }, "url": "{{baseUrl}}/api/auth/google" },
