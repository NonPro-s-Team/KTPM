          "request": { "auth": { "type": "noauth" }, "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }, { "key": "X-Test-Case", "value": "MANUAL-AUTH-002" }], "body": { "mode": "raw", "raw": "{\"tempToken\":\"{{tempToken}}\",\"password\":\"{{manualNewPassword}}\"}" }, "url": "{{baseUrl}}/api/auth/set-password" },
          "event": [
            { "listen": "prerequest", "script": { "exec": ["if (!pm.collectionVariables.get('tempToken') || !pm.collectionVariables.get('manualNewPassword')) pm.execution.skipRequest();"] } },
            { "listen": "test", "script": { "exec": ["pm.test('Set password succeeds', () => pm.response.to.have.status(200));"] } }
          ]
        },
        {
