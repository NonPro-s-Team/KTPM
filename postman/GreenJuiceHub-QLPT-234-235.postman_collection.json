    {
      "name": "QLPT-234 - Manual credential and expiry cases",
      "description": "Các case cần OTP đọc từ log, chờ thời gian thật, temp token hoặc Google ID token. Chúng được skip mặc định để không tạo kết quả giả.",
      "item": [
        {
          "name": "MANUAL-OTP-001 - Send OTP for before-expiry test",
          "request": { "auth": { "type": "noauth" }, "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }, { "key": "X-Test-Case", "value": "MANUAL-OTP-001" }], "body": { "mode": "raw", "raw": "{\"phone\":\"{{manualOtpPhone}}\",\"type\":\"LOGIN\"}" }, "url": "{{baseUrl}}/api/auth/send-otp" },
          "event": [
            { "listen": "prerequest", "script": { "exec": ["if (pm.collectionVariables.get('runManualOtpCases') !== 'true') pm.execution.skipRequest();"] } },
            { "listen": "test", "script": { "exec": ["pm.test('OTP sent', () => pm.response.to.have.status(200));"] } }
          ]
        },
        {
          "name": "MANUAL-OTP-002 - Verify immediately before expiry",
          "request": { "auth": { "type": "noauth" }, "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }, { "key": "X-Test-Case", "value": "MANUAL-OTP-002" }], "body": { "mode": "raw", "raw": "{\"phone\":\"{{manualOtpPhone}}\",\"otpCode\":\"{{otpCode}}\",\"type\":\"LOGIN\"}" }, "url": "{{baseUrl}}/api/auth/verify-otp" },
          "event": [
            { "listen": "prerequest", "script": { "exec": ["if (pm.collectionVariables.get('runManualOtpCases') !== 'true' || !pm.collectionVariables.get('otpCode')) pm.execution.skipRequest();"] } },
            { "listen": "test", "script": { "exec": ["pm.test('Valid unexpired OTP returns 200', () => pm.response.to.have.status(200));", "if (pm.response.code === 200) pm.collectionVariables.set('tempToken', pm.response.json().tempToken);"] } }
          ]
        },
        {
          "name": "MANUAL-OTP-003 - Verify after five-minute expiry",
          "description": "Gửi OTP mới cho một số riêng, đợi hơn 5 phút rồi chạy request này với otpCode tương ứng.",
          "request": { "auth": { "type": "noauth" }, "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }, { "key": "X-Test-Case", "value": "MANUAL-OTP-003" }], "body": { "mode": "raw", "raw": "{\"phone\":\"{{manualOtpPhone}}\",\"otpCode\":\"{{otpCode}}\",\"type\":\"LOGIN\"}" }, "url": "{{baseUrl}}/api/auth/verify-otp" },
          "event": [
            { "listen": "prerequest", "script": { "exec": ["if (pm.collectionVariables.get('runManualOtpCases') !== 'true' || !pm.collectionVariables.get('otpCode')) pm.execution.skipRequest();"] } },
            { "listen": "test", "script": { "exec": ["pm.test('Expired OTP returns 400', () => pm.response.to.have.status(400));", "pm.test('Message reports invalid or expired OTP', () => pm.expect(pm.response.json().message.toLowerCase()).to.include('hết hạn'));"] } }
          ]
        },
        {
          "name": "MANUAL-AUTH-001 - Login with OTP temp token",
          "request": { "auth": { "type": "noauth" }, "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }, { "key": "X-Test-Case", "value": "MANUAL-AUTH-001" }], "body": { "mode": "raw", "raw": "{\"tempToken\":\"{{tempToken}}\"}" }, "url": "{{baseUrl}}/api/auth/login-with-otp" },
          "event": [
