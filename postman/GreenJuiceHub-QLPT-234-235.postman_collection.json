            },
            {
              "name": "TOKEN-002 - Refresh token cannot access protected API",
              "request": { "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{refreshToken}}", "type": "string" }] }, "method": "GET", "header": [{ "key": "X-Test-Case", "value": "TOKEN-002" }], "url": "{{baseUrl}}/api/users/me" },
