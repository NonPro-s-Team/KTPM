              "name": "TOKEN-003 - Invalid refresh token",
              "request": { "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "not-a-jwt", "type": "string" }] }, "method": "POST", "header": [{ "key": "X-Test-Case", "value": "TOKEN-003" }], "url": "{{baseUrl}}/api/auth/refresh" },
