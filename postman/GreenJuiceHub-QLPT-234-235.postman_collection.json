              "description": "Yêu cầu bảo mật: logout phải thu hồi phiên, nên refresh token của cùng phiên không được cấp token mới.",
              "request": { "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{refreshToken}}", "type": "string" }] }, "method": "POST", "header": [{ "key": "X-Test-Case", "value": "AUTH-LOGOUT-003" }], "url": "{{baseUrl}}/api/auth/refresh" },
              "event": [{ "listen": "test", "script": { "exec": ["pm.test('Refresh token from logged-out session returns 401', () => pm.response.to.have.status(401));"] } }]
            }
