{
  "info": {
    "_postman_id": "b8a97d34-2aa8-4a8a-9e34-234235000001",
    "name": "Green Juice Hub - QLPT-234 & QLPT-235",
    "description": "Bộ test Postman cho QLPT-234 (Auth, User, Address) và các risk probe có thể tự động hóa của QLPT-235. Chạy theo thứ tự. Các request bắt đầu bằng MANUAL được bỏ qua mặc định; bật biến runManualOtpCases hoặc điền token tương ứng khi có dữ liệu thật. Mỗi request có mã test case để truy vết sang Jira.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{accessToken}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:8081" },
    { "key": "loginIdentifier", "value": "seed.user001@greenjuicehub.local" },
    { "key": "loginPassword", "value": "password" },
    { "key": "lockTestIdentifier", "value": "seed.user076@greenjuicehub.local" },
    { "key": "wrongPassword", "value": "wrong-password" },
    { "key": "accessToken", "value": "" },
    { "key": "refreshToken", "value": "" },
    { "key": "refreshedAccessToken", "value": "" },
    { "key": "rotatedRefreshToken", "value": "" },
    { "key": "addressId", "value": "" },
    { "key": "profileName", "value": "" },
    { "key": "otpPhone5", "value": "" },
    { "key": "otpPhone6", "value": "" },
    { "key": "otpPhone7", "value": "" },
    { "key": "runManualOtpCases", "value": "false" },
    { "key": "manualOtpPhone", "value": "" },
    { "key": "otpCode", "value": "" },
    { "key": "tempToken", "value": "" },
    { "key": "expiredRefreshToken", "value": "" },
    { "key": "googleIdToken", "value": "" },
    { "key": "manualNewPassword", "value": "" }
  ],
  "item": [
    {
      "name": "QLPT-234 - Automated Auth, User, Address",
      "description": "Luồng tự động, có dọn dữ liệu địa chỉ được tạo trong quá trình test.",
      "item": [
        {
          "name": "01 - Authentication setup and smoke",
          "item": [
            {
              "name": "AUTH-001 - Check existing account",
              "request": {
                "auth": { "type": "noauth" },
                "method": "POST",
                "header": [
                  { "key": "Content-Type", "value": "application/json" },
                  { "key": "X-Test-Case", "value": "AUTH-001" }
                ],
                "body": { "mode": "raw", "raw": "{\n  \"phone\": \"0910000001\"\n}" },
                "url": "{{baseUrl}}/api/auth/check-account"
              },
              "event": [
                {
                  "listen": "test",
                  "script": { "exec": [
                    "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
                    "pm.test('Account exists and has password', () => { const b = pm.response.json(); pm.expect(b.exists).to.eql(true); pm.expect(b.hasPassword).to.eql(true); });"
                  ] }
                }
              ]
            },
            {
              "name": "AUTH-002 - Login with password",
              "request": {
                "auth": { "type": "noauth" },
                "method": "POST",
                "header": [
                  { "key": "Content-Type", "value": "application/json" },
                  { "key": "X-Test-Case", "value": "AUTH-002" }
                ],
                "body": { "mode": "raw", "raw": "{\n  \"identifier\": \"{{loginIdentifier}}\",\n  \"password\": \"{{loginPassword}}\"\n}" },
                "url": "{{baseUrl}}/api/auth/login"
              },
              "event": [
                {
                  "listen": "test",
                  "script": { "exec": [
                    "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
                    "pm.test('Returns access and refresh tokens', () => { const b = pm.response.json(); pm.expect(b.accessToken).to.be.a('string').and.not.empty; pm.expect(b.refreshToken).to.be.a('string').and.not.empty; });",
                    "if (pm.response.code === 200) { const b = pm.response.json(); pm.collectionVariables.set('accessToken', b.accessToken); pm.collectionVariables.set('refreshToken', b.refreshToken); }"
                  ] }
                }
              ]
            },
            {
              "name": "AUTH-003 - Refresh token valid",
              "request": {
                "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{refreshToken}}", "type": "string" }] },
                "method": "POST",
                "header": [{ "key": "X-Test-Case", "value": "AUTH-003" }],
                "url": "{{baseUrl}}/api/auth/refresh"
              },
              "event": [
                {
                  "listen": "test",
                  "script": { "exec": [
                    "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
                    "pm.test('Refresh issues a new token pair', () => { const b = pm.response.json(); pm.expect(b.accessToken).to.be.a('string').and.not.empty; pm.expect(b.refreshToken).to.be.a('string').and.not.empty; });",
                    "if (pm.response.code === 200) { const b = pm.response.json(); pm.collectionVariables.set('refreshedAccessToken', b.accessToken); pm.collectionVariables.set('rotatedRefreshToken', b.refreshToken); }"
                  ] }
                }
              ]
            }
          ]
        },
        {
          "name": "02 - Phone length boundaries",
          "description": "Đầu vào số điện thoại có độ dài 0, 1, 14, 15, 16. Check-account đại diện luồng đăng ký; login kiểm tra chuỗi toàn chữ số được gửi như identifier đăng nhập.",
          "item": [
            {
              "name": "PHONE-REG-000 - Registration phone length 0",
              "request": { "auth": { "type": "noauth" }, "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }, { "key": "X-Test-Case", "value": "PHONE-REG-000" }], "body": { "mode": "raw", "raw": "{\"phone\":\"\"}" }, "url": "{{baseUrl}}/api/auth/check-account" },
              "event": [{ "listen": "test", "script": { "exec": ["pm.test('Reject empty phone with 400', () => pm.response.to.have.status(400));"] } }]
            },
            {
              "name": "PHONE-REG-001 - Registration phone length 1",
              "request": { "auth": { "type": "noauth" }, "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }, { "key": "X-Test-Case", "value": "PHONE-REG-001" }], "body": { "mode": "raw", "raw": "{\"phone\":\"0\"}" }, "url": "{{baseUrl}}/api/auth/check-account" },
              "event": [{ "listen": "test", "script": { "exec": ["pm.test('Reject length 1 with 400', () => pm.response.to.have.status(400));"] } }]
            },
            {
              "name": "PHONE-REG-014 - Registration phone length 14",
              "request": { "auth": { "type": "noauth" }, "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }, { "key": "X-Test-Case", "value": "PHONE-REG-014" }], "body": { "mode": "raw", "raw": "{\"phone\":\"09123456789012\"}" }, "url": "{{baseUrl}}/api/auth/check-account" },
              "event": [{ "listen": "test", "script": { "exec": ["pm.test('Reject length 14 with 400', () => pm.response.to.have.status(400));"] } }]
            },
            {
              "name": "PHONE-REG-015 - Registration phone length 15",
              "request": { "auth": { "type": "noauth" }, "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }, { "key": "X-Test-Case", "value": "PHONE-REG-015" }], "body": { "mode": "raw", "raw": "{\"phone\":\"091234567890123\"}" }, "url": "{{baseUrl}}/api/auth/check-account" },
              "event": [{ "listen": "test", "script": { "exec": ["pm.test('Reject length 15 with 400', () => pm.response.to.have.status(400));"] } }]
            },
            {
              "name": "PHONE-REG-016 - Registration phone length 16",
              "request": { "auth": { "type": "noauth" }, "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }, { "key": "X-Test-Case", "value": "PHONE-REG-016" }], "body": { "mode": "raw", "raw": "{\"phone\":\"0912345678901234\"}" }, "url": "{{baseUrl}}/api/auth/check-account" },
              "event": [{ "listen": "test", "script": { "exec": ["pm.test('Reject length 16 with 400', () => pm.response.to.have.status(400));"] } }]
            },
            {
              "name": "PHONE-LOGIN-000 - Login phone length 0",
              "request": { "auth": { "type": "noauth" }, "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }, { "key": "X-Test-Case", "value": "PHONE-LOGIN-000" }], "body": { "mode": "raw", "raw": "{\"identifier\":\"\",\"password\":\"{{wrongPassword}}\"}" }, "url": "{{baseUrl}}/api/auth/login" },
              "event": [{ "listen": "test", "script": { "exec": ["pm.test('Reject empty identifier with 400', () => pm.response.to.have.status(400));"] } }]
            },
            {
              "name": "PHONE-LOGIN-001 - Login numeric phone length 1",
              "request": { "auth": { "type": "noauth" }, "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }, { "key": "X-Test-Case", "value": "PHONE-LOGIN-001" }], "body": { "mode": "raw", "raw": "{\"identifier\":\"0\",\"password\":\"{{wrongPassword}}\"}" }, "url": "{{baseUrl}}/api/auth/login" },
              "event": [{ "listen": "test", "script": { "exec": ["pm.test('Malformed numeric phone should be validation error 400', () => pm.response.to.have.status(400));"] } }]
            },
            {
              "name": "PHONE-LOGIN-014 - Login numeric phone length 14",
              "request": { "auth": { "type": "noauth" }, "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }, { "key": "X-Test-Case", "value": "PHONE-LOGIN-014" }], "body": { "mode": "raw", "raw": "{\"identifier\":\"09123456789012\",\"password\":\"{{wrongPassword}}\"}" }, "url": "{{baseUrl}}/api/auth/login" },
              "event": [{ "listen": "test", "script": { "exec": ["pm.test('Malformed numeric phone should be validation error 400', () => pm.response.to.have.status(400));"] } }]
            },
            {
              "name": "PHONE-LOGIN-015 - Login numeric phone length 15",
              "request": { "auth": { "type": "noauth" }, "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }, { "key": "X-Test-Case", "value": "PHONE-LOGIN-015" }], "body": { "mode": "raw", "raw": "{\"identifier\":\"091234567890123\",\"password\":\"{{wrongPassword}}\"}" }, "url": "{{baseUrl}}/api/auth/login" },
              "event": [{ "listen": "test", "script": { "exec": ["pm.test('Malformed numeric phone should be validation error 400', () => pm.response.to.have.status(400));"] } }]
            },
            {
              "name": "PHONE-LOGIN-016 - Login numeric phone length 16",
              "request": { "auth": { "type": "noauth" }, "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }, { "key": "X-Test-Case", "value": "PHONE-LOGIN-016" }], "body": { "mode": "raw", "raw": "{\"identifier\":\"0912345678901234\",\"password\":\"{{wrongPassword}}\"}" }, "url": "{{baseUrl}}/api/auth/login" },
              "event": [{ "listen": "test", "script": { "exec": ["pm.test('Malformed numeric phone should be validation error 400', () => pm.response.to.have.status(400));"] } }]
            }
          ]
        },
        {
          "name": "03 - OTP length boundaries",
          "description": "Mỗi độ dài dùng một số điện thoại riêng để tránh khóa chéo số lần nhập sai.",
          "item": [
            {
              "name": "OTP-SETUP - Generate isolated test phones",
              "request": { "auth": { "type": "noauth" }, "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }, { "key": "X-Test-Case", "value": "OTP-SETUP" }], "body": { "mode": "raw", "raw": "{\"phone\":\"{{otpPhone5}}\",\"type\":\"REGISTER\"}" }, "url": "{{baseUrl}}/api/auth/send-otp" },
              "event": [
                { "listen": "prerequest", "script": { "exec": [
                  "const suffix = String(Date.now()).slice(-7);",
                  "pm.collectionVariables.set('otpPhone5', '09' + suffix + '5');",
                  "pm.collectionVariables.set('otpPhone6', '09' + suffix + '6');",
                  "pm.collectionVariables.set('otpPhone7', '09' + suffix + '7');"
                ] } },
                { "listen": "test", "script": { "exec": ["pm.test('OTP created for 5-digit boundary case', () => pm.response.to.have.status(200));"] } }
              ]
            },
            {
              "name": "OTP-LEN-005 - Verify OTP length 5",
              "request": { "auth": { "type": "noauth" }, "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }, { "key": "X-Test-Case", "value": "OTP-LEN-005" }], "body": { "mode": "raw", "raw": "{\"phone\":\"{{otpPhone5}}\",\"otpCode\":\"12345\",\"type\":\"REGISTER\"}" }, "url": "{{baseUrl}}/api/auth/verify-otp" },
              "event": [{ "listen": "test", "script": { "exec": [
                "pm.test('Reject OTP length 5 with 400', () => pm.response.to.have.status(400));",
                "pm.test('Message identifies the six-character constraint', () => pm.expect(pm.response.json().message.toLowerCase()).to.include('6'));"
              ] } }]
            },
            {
              "name": "OTP-SETUP-006 - Send OTP for length 6",
              "request": { "auth": { "type": "noauth" }, "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }, { "key": "X-Test-Case", "value": "OTP-SETUP-006" }], "body": { "mode": "raw", "raw": "{\"phone\":\"{{otpPhone6}}\",\"type\":\"REGISTER\"}" }, "url": "{{baseUrl}}/api/auth/send-otp" },
              "event": [{ "listen": "test", "script": { "exec": ["pm.test('OTP created for 6-digit case', () => pm.response.to.have.status(200));"] } }]
            },
            {
              "name": "OTP-LEN-006 - Verify wrong OTP length 6",
              "request": { "auth": { "type": "noauth" }, "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }, { "key": "X-Test-Case", "value": "OTP-LEN-006" }], "body": { "mode": "raw", "raw": "{\"phone\":\"{{otpPhone6}}\",\"otpCode\":\"999999\",\"type\":\"REGISTER\"}" }, "url": "{{baseUrl}}/api/auth/verify-otp" },
              "event": [{ "listen": "test", "script": { "exec": [
                "pm.test('Wrong six-digit OTP returns 400', () => pm.response.to.have.status(400));",
                "pm.test('Message reports incorrect OTP', () => pm.expect(pm.response.json().message).to.include('OTP'));"
              ] } }]
            },
            {
              "name": "OTP-SETUP-007 - Send OTP for length 7",
              "request": { "auth": { "type": "noauth" }, "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }, { "key": "X-Test-Case", "value": "OTP-SETUP-007" }], "body": { "mode": "raw", "raw": "{\"phone\":\"{{otpPhone7}}\",\"type\":\"REGISTER\"}" }, "url": "{{baseUrl}}/api/auth/send-otp" },
              "event": [{ "listen": "test", "script": { "exec": ["pm.test('OTP created for 7-digit boundary case', () => pm.response.to.have.status(200));"] } }]
            },
            {
              "name": "OTP-LEN-007 - Verify OTP length 7",
              "request": { "auth": { "type": "noauth" }, "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }, { "key": "X-Test-Case", "value": "OTP-LEN-007" }], "body": { "mode": "raw", "raw": "{\"phone\":\"{{otpPhone7}}\",\"otpCode\":\"1234567\",\"type\":\"REGISTER\"}" }, "url": "{{baseUrl}}/api/auth/verify-otp" },
              "event": [{ "listen": "test", "script": { "exec": [
                "pm.test('Reject OTP length 7 with 400', () => pm.response.to.have.status(400));",
                "pm.test('Message identifies the six-character constraint', () => pm.expect(pm.response.json().message.toLowerCase()).to.include('6'));"
              ] } }]
            }
          ]
        },
        {
          "name": "04 - Repeated wrong password",
          "description": "Dùng tài khoản seed riêng. Sau lần 5 hệ thống yêu cầu captcha; trạng thái Redis tự hết hạn sau 15 phút.",
          "item": [
            {
              "name": "LOGIN-FAIL-001 - Wrong password attempt 1",
              "request": { "auth": { "type": "noauth" }, "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }, { "key": "X-Test-Case", "value": "LOGIN-FAIL-001" }], "body": { "mode": "raw", "raw": "{\"identifier\":\"{{lockTestIdentifier}}\",\"password\":\"{{wrongPassword}}\"}" }, "url": "{{baseUrl}}/api/auth/login" },
              "event": [{ "listen": "test", "script": { "exec": ["pm.test('Attempt 1 returns 401', () => pm.response.to.have.status(401));"] } }]
            },
            {
              "name": "LOGIN-FAIL-002 - Wrong password attempt 2",
              "request": { "auth": { "type": "noauth" }, "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }, { "key": "X-Test-Case", "value": "LOGIN-FAIL-002" }], "body": { "mode": "raw", "raw": "{\"identifier\":\"{{lockTestIdentifier}}\",\"password\":\"{{wrongPassword}}\"}" }, "url": "{{baseUrl}}/api/auth/login" },
              "event": [{ "listen": "test", "script": { "exec": ["pm.test('Attempt 2 returns 401', () => pm.response.to.have.status(401));"] } }]
            },
            {
              "name": "LOGIN-FAIL-003 - Wrong password attempt 3",
              "request": { "auth": { "type": "noauth" }, "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }, { "key": "X-Test-Case", "value": "LOGIN-FAIL-003" }], "body": { "mode": "raw", "raw": "{\"identifier\":\"{{lockTestIdentifier}}\",\"password\":\"{{wrongPassword}}\"}" }, "url": "{{baseUrl}}/api/auth/login" },
              "event": [{ "listen": "test", "script": { "exec": ["pm.test('Attempt 3 returns 401', () => pm.response.to.have.status(401));"] } }]
            },
            {
              "name": "LOGIN-FAIL-004 - Wrong password attempt 4",
              "request": { "auth": { "type": "noauth" }, "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }, { "key": "X-Test-Case", "value": "LOGIN-FAIL-004" }], "body": { "mode": "raw", "raw": "{\"identifier\":\"{{lockTestIdentifier}}\",\"password\":\"{{wrongPassword}}\"}" }, "url": "{{baseUrl}}/api/auth/login" },
              "event": [{ "listen": "test", "script": { "exec": ["pm.test('Attempt 4 returns 401', () => pm.response.to.have.status(401));"] } }]
            },
            {
              "name": "LOGIN-FAIL-005 - Wrong password triggers captcha",
              "request": { "auth": { "type": "noauth" }, "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }, { "key": "X-Test-Case", "value": "LOGIN-FAIL-005" }], "body": { "mode": "raw", "raw": "{\"identifier\":\"{{lockTestIdentifier}}\",\"password\":\"{{wrongPassword}}\"}" }, "url": "{{baseUrl}}/api/auth/login" },
              "event": [{ "listen": "test", "script": { "exec": [
                "pm.test('Attempt 5 returns 403', () => pm.response.to.have.status(403));",
                "pm.test('Captcha is required', () => pm.expect(pm.response.json().message.toLowerCase()).to.include('captcha'));"
              ] } }]
            },
            {
              "name": "LOGIN-FAIL-006 - Further attempt blocked without captcha",
              "request": { "auth": { "type": "noauth" }, "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }, { "key": "X-Test-Case", "value": "LOGIN-FAIL-006" }], "body": { "mode": "raw", "raw": "{\"identifier\":\"{{lockTestIdentifier}}\",\"password\":\"{{wrongPassword}}\"}" }, "url": "{{baseUrl}}/api/auth/login" },
              "event": [{ "listen": "test", "script": { "exec": [
                "pm.test('Further attempt is blocked with 400', () => pm.response.to.have.status(400));",
                "pm.test('Response asks for captcha', () => pm.expect(pm.response.json().message.toLowerCase()).to.include('captcha'));"
              ] } }]
            }
          ]
        },
        {
          "name": "05 - User profile",
          "item": [
            {
              "name": "USER-001 - Get current profile",
              "request": { "method": "GET", "header": [{ "key": "X-Test-Case", "value": "USER-001" }], "url": "{{baseUrl}}/api/users/me" },
              "event": [{ "listen": "test", "script": { "exec": [
                "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
                "pm.test('Profile belongs to authenticated user', () => { const b = pm.response.json(); pm.expect(b.id).to.exist; pm.expect(b.role).to.exist; });",
                "if (pm.response.code === 200) pm.collectionVariables.set('profileName', pm.response.json().name);"
              ] } }]
            },
            {
              "name": "USER-002 - Update profile without changing value",
              "request": { "method": "PUT", "header": [{ "key": "Content-Type", "value": "application/json" }, { "key": "X-Test-Case", "value": "USER-002" }], "body": { "mode": "raw", "raw": "{\"name\":\"{{profileName}}\"}" }, "url": "{{baseUrl}}/api/users/me" },
              "event": [{ "listen": "test", "script": { "exec": ["pm.test('HTTP 200', () => pm.response.to.have.status(200));", "pm.test('Name remains unchanged', () => pm.expect(pm.response.json().name).to.eql(pm.collectionVariables.get('profileName')));"] } }]
            },
            {
              "name": "USER-003 - Reject invalid email",
              "request": { "method": "PUT", "header": [{ "key": "Content-Type", "value": "application/json" }, { "key": "X-Test-Case", "value": "USER-003" }], "body": { "mode": "raw", "raw": "{\"email\":\"not-an-email\"}" }, "url": "{{baseUrl}}/api/users/me" },
              "event": [{ "listen": "test", "script": { "exec": ["pm.test('Invalid email returns 400', () => pm.response.to.have.status(400));"] } }]
            },
            {
              "name": "USER-004 - Reject mismatched password confirmation",
              "request": { "method": "PUT", "header": [{ "key": "Content-Type", "value": "application/json" }, { "key": "X-Test-Case", "value": "USER-004" }], "body": { "mode": "raw", "raw": "{\"currentPassword\":\"{{loginPassword}}\",\"newPassword\":\"new-password-123\",\"confirmPassword\":\"different-password-123\"}" }, "url": "{{baseUrl}}/api/users/me/password" },
              "event": [{ "listen": "test", "script": { "exec": ["pm.test('Mismatch returns 400 without changing password', () => pm.response.to.have.status(400));"] } }]
            },
            {
              "name": "AUTH-CHANGE-001 - Reject short password",
              "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }, { "key": "X-Test-Case", "value": "AUTH-CHANGE-001" }], "body": { "mode": "raw", "raw": "{\"oldPassword\":\"{{loginPassword}}\",\"newPassword\":\"short\"}" }, "url": "{{baseUrl}}/api/auth/change-password" },
              "event": [{ "listen": "test", "script": { "exec": ["pm.test('Short password returns 400 without changing password', () => pm.response.to.have.status(400));"] } }]
            }
          ]
        },
        {
          "name": "06 - Address CRUD",
          "description": "Tạo một địa chỉ test, cập nhật, đặt mặc định và xóa ở cuối.",
          "item": [
            {
              "name": "ADDRESS-001 - List addresses",
              "request": { "method": "GET", "header": [{ "key": "X-Test-Case", "value": "ADDRESS-001" }], "url": "{{baseUrl}}/api/users/me/addresses" },
